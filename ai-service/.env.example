# --- Cloudflare Workers AI (never commit real values) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
SENTIMENT_MODEL=@cf/huggingface/distilbert-sst-2-int8
EMOTION_MODEL=@cf/ibm-granite/granite-4.0-h-micro
CF_TIMEOUT_S=20
CF_MAX_RETRIES=2
# --- Limits ---
MAX_REVIEW_CHARS=2000
MAX_BATCH_SIZE=30
MAX_CONCURRENCY=4
CACHE_TTL_S=86400
CACHE_MAX_ENTRIES=2000
# --- Internal auth: Express must send this in X-Internal-Token ---
INTERNAL_API_TOKEN=change-me
# --- Risk weights (normalised to sum 1) and thresholds ---
W_INTENSITY=0.40
W_NEGATIVE=0.25
W_EXTREME=0.20
W_EXAGGERATION=0.15
THRESHOLD_MODERATE=30
THRESHOLD_HIGH=60
GATE_FLOOR=0.5
NEUTRAL_CONF_THRESHOLD=0.65
APP_ENV=development            # set to production on Render; then INTERNAL_API_TOKEN (>=16 chars) is mandatory
CF_BASE_URL=https://api.cloudflare.com/client/v4
